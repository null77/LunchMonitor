# LunchMoney API Token (get from https://my.lunchmoney.app/developers)
LUNCHMONEY_TOKEN=your_api_token_here

# SMTP Configuration for notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Optional: Override config file location
# LUNCHMONITOR_CONFIG=~/.config/lunchmonitor/config.json
