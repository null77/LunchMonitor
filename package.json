{
  "name": "lunchmonitor",
  "version": "1.0.0",
  "private": true,
  "description": "Budget monitoring service for LunchMoney API",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "bun run build:core && bun run build:cli && bun run build:web",
    "build:core": "bun run --cwd packages/core build",
    "build:cli": "bun run --cwd packages/cli build",
    "build:web": "bun run --cwd packages/web build",
    "dev:web": "bun run --cwd packages/web dev",
    "test": "bun test",
    "typecheck": "tsc --build && tsc -p packages/core/tsconfig.test.json",
    "cli": "bun run packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.3.0"
  }
}
